# --- Core ---------------------------------------------------------------
# Local dev uses SQLite. For Supabase/RDS: postgresql+psycopg://user:pass@host:5432/postgres
DATABASE_URL=sqlite:///./bruno.db
REDIS_URL=redis://localhost:6379/0

# --- Restaurant ---------------------------------------------------------
RESTAURANT_NAME=Tony's
AGENT_NAME=Marco
RESTAURANT_TIMEZONE=America/New_York
TAX_RATE=0.08
MIN_PREP_MINUTES=25
# Leave blank if customers can call the same number they're texting with.
VOICE_PHONE_NUMBER=

# --- LLM (auto = OpenAI if key set, else Anthropic, else offline mock) ---
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Texting: console | sendblue ---------------------------------------
MESSAGING_PROVIDER=console
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=
SENDBLUE_STATUS_CALLBACK_URL=
INCLUDE_OPT_OUT_FOOTER=true

# Required on every webhook as ?secret=... or an X-Bruno-Secret header. Set this in production.
WEBHOOK_SECRET=

# --- POS: console | square ---------------------------------------------
POS_PROVIDER=console
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_BASE_URL=https://connect.squareupsandbox.com

# --- Cadence engine -----------------------------------------------------
DRIFT_MULTIPLIER=1.25
OUTREACH_COOLDOWN_DAYS=7
OUTREACH_SCAN_HOUR=15
OUTREACH_SEND_TIME=16:30

# --- Optional weather context (Open-Meteo, no key) ----------------------
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
