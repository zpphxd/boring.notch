# Everything except DATABASE_URL can also be entered in the dashboard (Settings),
# and dashboard values win. Use this file if you prefer environment variables.

# --- Required for production ------------------------------------------------
# Postgres/Supabase: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./bruno.db
# e.g. https://bruno.tonyspizza.com (used to show webhook URLs)
PUBLIC_BASE_URL=
# or create one on first visit to /admin
ADMIN_PASSWORD=
# optional; auto-generated and stored in the DB if unset
SECRET_KEY=

# --- AI (either one) --------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Texting -------------------------------------------------------------------
# auto = BlueBubbles if configured, else Sendblue, else print texts to the console
MESSAGING_PROVIDER=auto
# appended to webhook URLs as ?secret=
WEBHOOK_SECRET=

# BlueBubbles Server on a Mac signed into iMessage (proof-of-concept volumes)
# e.g. https://xyz.trycloudflare.com or http://192.168.1.20:1234
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
# true once the BlueBubbles Private API helper is set up (typing bubbles)
BLUEBUBBLES_PRIVATE_API=false

# Sendblue (hosted iMessage + SMS), the alternative for production volume
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=

# --- Payments: Stripe (blank = pay at pickup) --------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REQUIRE_PREPAY=false

# --- POS: Square (blank = kitchen tickets print to the console/log) ----------
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# --- Delivery: DoorDash Drive (blank = pickup, or the store link below) -------
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
DOORDASH_STORE_URL=

# --- Restaurant -------------------------------------------------------------------
RESTAURANT_NAME=Tony's
AGENT_NAME=Marco
RESTAURANT_TIMEZONE=America/New_York
RESTAURANT_ADDRESS=
RESTAURANT_PHONE=
OWNER_PHONE=
